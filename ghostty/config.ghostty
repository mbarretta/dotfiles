theme = Solarized Dark Higher Contrast
# theme = Cobalt2
copy-on-select = clipboard
font-size = 14

# always default to ~/ vs current working directory in other tabs/windows
working-directory = ~/workspace/github/mbarretta
window-inherit-working-directory = false
tab-inherit-working-directory = false

# reopen tabs on restart
window-save-state = always

# cmd + arrow to move between tabs
keybind = super+arrow_right=next_tab
keybind = super+arrow_left=previous_tab

# machine-local overrides — resolved next to the live symlink, loads after this
# file so local values win; ? makes it optional (never committed)
config-file = ?config.local.ghostty