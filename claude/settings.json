{
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "clickhouse-skills": {
      "source": {
        "repo": "ClickHouse/skills",
        "source": "github"
      }
    },
    "elastic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/elastic/agent-skills.git"
      }
    },
    "mab-agent-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "mbarretta/mab-agent-skills",
        "source": "github"
      }
    },
    "obsidian-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "kepano/obsidian-skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/project-vault.py\" mirror",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/project-vault.py\" end",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/project-vault.py\" start",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/workspace/obsidian-claude-vault"
    ],
    "allow": [
      "Bash(/Users/michael.barretta/.claude/plugins/cache/mab-agent-skills/mab-harness/*/scripts/plan-review.sh *)"
    ],
    "defaultMode": "auto"
  },
  "plansDirectory": ".claude/plans",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "refreshInterval": 15,
    "type": "command"
  },
  "theme": "dark-daltonized"
}
